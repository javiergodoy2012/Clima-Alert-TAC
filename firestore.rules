rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.estado in ["aprobado", "Aprobado", "APROBADO"];
    }

    function isThresholdAdmin() {
      return isApproved()
        && request.auth.uid == "pgyrN5bxRuWsnfHTheMfOgkFpJX2";
    }

    match /usuarios/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.estado == "pendiente";

      allow read: if isOwner(userId);
      allow update, delete: if false;

      match /dispositivos/{deviceId} {
        allow read: if isOwner(userId) && isApproved();
        allow create, update: if isOwner(userId)
          && isApproved()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20
          && request.resource.data.activo == true
          && request.resource.data.keys().hasOnly([
            "uid", "token", "activo", "plataforma", "createdAt", "updatedAt"
          ]);
        allow delete: if isOwner(userId) && isApproved();
      }
    }

    match /datosOperativos/{document=**} {
      allow read: if isApproved();
      allow write: if false;
    }

    match /alertasBot/{ramalId} {
      allow read: if isApproved();
      allow write: if false;
    }

    match /historialAlertasBot/{alertaId} {
      allow read: if isApproved();
      allow write: if false;
    }

    match /estadoBot/{documento} {
      allow read: if isApproved();
      allow write: if false;
    }

    match /configuracion/climaAlertBot {
      allow read: if isApproved();
      allow create: if isThresholdAdmin()
        && request.resource.data.keys().hasOnly([
          "thresholds", "thresholdsUpdatedAt", "thresholdsUpdatedBy", "thresholdsUpdatedByName"
        ])
        && request.resource.data.thresholdsUpdatedBy == request.auth.uid;
      allow update: if isThresholdAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "thresholds", "thresholdsUpdatedAt", "thresholdsUpdatedBy", "thresholdsUpdatedByName"
        ])
        && request.resource.data.thresholdsUpdatedBy == request.auth.uid;
      allow delete: if false;
    }
  }
}
